# ---- Required in production ---------------------------------------------------
# Public hostname of the web app/API (Caddy gets a Let's Encrypt certificate for it).
APP_DOMAIN=mail-app.example.com
# Full public URL (defaults to https://$APP_DOMAIN).
# APP_URL=https://mail-app.example.com
# Other public URLs serving the same app (comma-separated), each gets its own SSO callback.
# APP_EXTRA_URLS=https://mail.other-domain.example

# Shared secret between the Cloudflare Email Worker and the app (openssl rand -hex 32).
# Must be identical to the Worker secret set with: npx wrangler secret put INGEST_SECRET
INGEST_SECRET=change-me-to-a-long-random-string

# Single sign-on (OpenID Connect) — the ONLY way to log in.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=throwaway-mail
OIDC_CLIENT_SECRET=
# Members of this group are admins (synced at every sign-in).
OIDC_ADMIN_GROUP=admins
# Optional: only these groups may sign in (comma-separated). Empty = whoever the IdP lets through.
OIDC_ALLOWED_GROUPS=
OIDC_PROVIDER_NAME=Authelia

# Cloudflare API token (scopes: Zone:Zone:Read, Zone:Email Routing Rules:Edit, Account:Email Routing Addresses:Edit,
# Zone:DNS:Read; Account:Workers Scripts:Read optional) and account id.
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Name of the deployed Email Worker (worker/wrangler.toml "name").
WORKER_NAME=throwaway-mail-ingest

# ---- Optional -----------------------------------------------------------------
# 1 = no Cloudflare calls at all (local development / demo). Domains become "active" instantly,
# destinations become verified when you press "Check status".
CF_MOCK=0
# Days to keep messages (0 = forever).
RETENTION_DAYS=30
# debug | info | warn | error  (bodies and codes are only ever logged at debug)
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Host port the app listens on (127.0.0.1 only) when running behind your own reverse proxy.
APP_PORT=3310
BACKUP_KEEP_DAYS=14
# Host ports for the bundled Caddy (docker compose --profile caddy).
# HTTP_PORT=80
# HTTPS_PORT=443
