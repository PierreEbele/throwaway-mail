# Throwaway Mail configuration. Copy to .env next to docker-compose.yml and edit.
# Every variable the app reads is listed (app/server/config.ts); commented ones show their default.
# Empty values count as unset. Check the result with: docker compose exec app node dist/doctor.js (or Admin → Setup check)

# ---- Required in production ---------------------------------------------------
# Public hostname of the web app/API (the bundled Caddy gets a Let's Encrypt certificate for it).
APP_DOMAIN=mail-app.example.com
# Full public URL; docker compose defaults it to https://$APP_DOMAIN. Used for SSO callbacks and secure cookies.
# APP_URL=https://mail-app.example.com
# Other public URLs serving the same app (comma-separated), each gets its own SSO callback.
# APP_EXTRA_URLS=https://mail.other-domain.example

# Shared secret between the Cloudflare Email Worker and the app (openssl rand -hex 32, 16+ characters).
# Must be identical to the Worker secret set with: npx wrangler secret put INGEST_SECRET
INGEST_SECRET=change-me-to-a-long-random-string

# Key that encrypts IMAP/SMTP passwords stored in the database (openssl rand -hex 32, 32+ characters).
# Required to add a domain with an IMAP/SMTP mailbox; never change it afterwards (stored passwords become unreadable).
APP_SECRET=

# ---- Sign-in -------------------------------------------------------------------
# Local accounts (e-mail + password): auto = only when single sign-on is not configured (the first visitor
# creates the admin account), true = offer both, false = single sign-on only (OIDC_* then required).
LOCAL_LOGIN=auto

# Single sign-on (OpenID Connect), optional. Leave OIDC_ISSUER / OIDC_CLIENT_SECRET empty to use local accounts only.
# Redirect URI to register at the IdP: $APP_URL/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=throwaway-mail
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email groups
# Members of this group are admins (synced at every sign-in).
OIDC_ADMIN_GROUP=admins
# Optional: only these groups may sign in (comma-separated). Empty = whoever the IdP lets through.
OIDC_ALLOWED_GROUPS=
# Name shown on the sign-in button.
OIDC_PROVIDER_NAME=Authelia
# 1 = allow an http:// issuer (local development and tests only).
# OIDC_ALLOW_INSECURE=0
# Days a session stays valid.
# SESSION_TTL_DAYS=14

# ---- Cloudflare Email Routing ---------------------------------------------------
# API token (scopes: Zone:Zone:Read, Zone:Email Routing Rules:Edit, Account:Email Routing Addresses:Edit,
# Zone:DNS:Read; Account:Workers Scripts:Read optional) and account id. Empty = IMAP/SMTP domains only.
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Name of the deployed Email Worker (worker/wrangler.toml "name").
WORKER_NAME=throwaway-mail-ingest
# 1 = no Cloudflare calls at all (local development / demo). Domains become "active" instantly,
# destinations become verified when you press "Check status".
CF_MOCK=0

# ---- Mail handling --------------------------------------------------------------
# Days to keep messages (0 = forever).
RETENTION_DAYS=30
# Largest accepted raw message, in bytes (default 25 MB).
# MAX_INGEST_BYTES=26214400
# 1 = experimental LLM fallback for code extraction.
# PARSER_LLM_FALLBACK=0

# ---- Operations ---------------------------------------------------------------
# debug | info | warn | error  (bodies and codes are only ever logged at debug)
LOG_LEVEL=info
# API requests per minute per client, and sign-in attempts per minute per IP.
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Optional: enables GET /metrics (Prometheus) with "Authorization: Bearer <token>" (16+ characters).
# METRICS_TOKEN=
# Force the Secure flag on cookies (default: on when APP_URL is https).
# COOKIE_SECURE=true
# Days of backups kept by scripts/backup.sh (in /data/backups).
BACKUP_KEEP_DAYS=14
# Time zone of the container (logs, backup names).
# TZ=UTC

# ---- Docker Compose only (not read by the app) ------------------------------------
# Host port the app listens on (127.0.0.1 only) when running behind your own reverse proxy.
APP_PORT=3310
# Host ports for the bundled Caddy (docker compose --profile caddy).
# HTTP_PORT=80
# HTTPS_PORT=443
# Image tag for docker-compose.example.yml: latest, 1, 1.2, 1.2.3 or edge.
# TM_VERSION=latest

# ---- Set by the image, rarely changed -------------------------------------------
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=/data
# DATABASE_PATH=/data/throwaway.db
# MIGRATIONS_DIR=/app/migrations
# WEB_DIST_DIR=/app/dist/web
