{
  "manifest_version": 3,
  "name": "Throwaway Mail",
  "version": "1.11.1",
  "description": "Fake identities with real Throwaway Mail disposable addresses, and automatic verification code retrieval.",
  "permissions": ["alarms", "activeTab", "menus", "scripting", "storage"],
  "action": {
    "default_title": "Throwaway Mail",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/throwaway-mail.svg",
      "64": "icons/throwaway-mail.svg"
    }
  },
  "icons": {
    "32": "icons/throwaway-mail.svg",
    "64": "icons/throwaway-mail.svg",
    "128": "icons/throwaway-mail.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "throwaway-mail@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["generator.js", "throwaway.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
