{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": ["app/server", "scripts", "tests", "drizzle.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
