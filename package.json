{
  "name": "throwaway-mail",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted disposable e-mail addresses on Cloudflare Email Routing, with code extraction, forwarding and a web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreEbele/throwaway-mail.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch app/server/main.ts",
    "dev:web": "vite --config app/web/vite.config.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build --config app/web/vite.config.ts",
    "build:server": "esbuild app/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate-mail.ts",
    "fake-oidc": "tsx scripts/fake-idp.ts",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json && tsc --noEmit --noUnusedLocals --noUnusedParameters -p app/web/tsconfig.json && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.14",
    "openid-client": "^6.8.8",
    "openpgp": "^6.3.2",
    "postal-mime": "^4.2.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
